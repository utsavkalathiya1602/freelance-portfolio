# Copy to .env.local and fill in. Set the same variables in your hosting provider (e.g. Vercel).

# Public site URL, used for canonical links, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Cloudinary cloud name — public, used to build image URLs.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Cloudinary API credentials — server-side only, used by `npm run images:upload`.
# Never prefix these with NEXT_PUBLIC_.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
